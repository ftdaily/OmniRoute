# Build this local image from the exact release checkout as documented below,
# or replace it with an immutable published image digest. Do not use a floating
# tag such as :latest or :next for an unattended VPS.
# Public fork images are published to ghcr.io/ftdaily/omniroute.
OMNIROUTE_IMAGE=omniroute:3.8.51-vps

# The dashboard is loopback-only by default. Keep this value unless a trusted
# reverse proxy or private overlay network is configured on the same host.
OMNIROUTE_BIND_HOST=127.0.0.1
OMNIROUTE_PORT=20128

# Generate unique values before the first start. Do not commit the resulting .env.
JWT_SECRET=
API_KEY_SECRET=
OMNIROUTE_WS_BRIDGE_SECRET=
INITIAL_PASSWORD=
REQUIRE_API_KEY=true

# Conservative defaults for a small VPS. Adjust after observing real usage.
#
# Memory is a two-number setting and both numbers matter:
#   OMNIROUTE_MEMORY_MB    -> the V8 heap. Becomes NODE_OPTIONS=--max-old-space-size.
#   OMNIROUTE_MEMORY_LIMIT -> the cgroup cap for the whole container.
# The heap MUST stay strictly below the container cap: native buffers, the SQLite
# cache and Node's own baseline live outside V8, so a heap that reaches the cap gets
# OOM-killed instead of garbage-collected.
#
# Runtime floor is 2 GiB of container RAM (see README). Source builds need 8 GiB+.
OMNIROUTE_MEMORY_MB=1024
OMNIROUTE_MEMORY_LIMIT=2g
OMNIROUTE_CPUS=1.0
OMNIROUTE_PIDS_LIMIT=256
APP_LOG_LEVEL=info
