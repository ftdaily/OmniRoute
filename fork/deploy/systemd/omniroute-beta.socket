[Unit]
Description=OmniRoute Beta socket (cold start, :20129)
# Public Beta port. The kernel holds :20129 while the backend sleeps; first
# connection wakes the proxy, which wakes the backend.
Before=omniroute-beta-proxy.service

[Socket]
ListenStream=127.0.0.1:20129
# Hermes/OpenViking/opencode keep localhost:20129; no per-connection service.
Accept=no

[Install]
WantedBy=sockets.target
